rhal.module @rax_executor_mpi_e2e_rank0 attributes {version = "0.1.0"} {
  rhal.codeobj @init_shared {id = 10 : i32, kind = "host_shared_lib",
                             backend = "cpu",
                             uri = "file:@RAX_EXECUTOR_MPI_E2E_LIBRARY@",
                             entry_symbol = "init_shared"}
  rhal.codeobj @compute_partial {id = 11 : i32, kind = "host_shared_lib",
                                 backend = "cpu",
                                 uri = "file:@RAX_EXECUTOR_MPI_E2E_LIBRARY@",
                                 entry_symbol = "compute_partial"}
  rhal.codeobj @finish {id = 12 : i32, kind = "host_shared_lib",
                        backend = "cpu",
                        uri = "file:@RAX_EXECUTOR_MPI_E2E_LIBRARY@",
                        entry_symbol = "finish"}

  rhal.buffer @scale {space = "host", type = tensor<2xf32>}
  rhal.buffer @bias {space = "host", type = tensor<2xf32>}
  rhal.buffer @input {space = "host", type = tensor<2xf32>}
  rhal.buffer @partial {space = "host", type = tensor<2xf32>}
  rhal.buffer @output {space = "host", type = tensor<2xf32>}

  rhal.func @forward {inputs = ["input"], outputs = ["output"]} body {
    rhal.dispatch @init_shared [@scale, @bias]
    rhal.collective [@scale, @bias] {
      kind = "broadcast",
      root = 0 : i32
    }
    rhal.dispatch @compute_partial [@input, @scale, @bias, @partial]
    rhal.collective [@partial] {
      kind = "all_reduce",
      reduction = "sum"
    }
    rhal.dispatch @finish [@partial, @bias, @output]
  }
}
